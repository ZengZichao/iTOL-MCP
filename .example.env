# =========================================================
# iTOL-MCP 示例环境变量（复制为 .env 或直接 export）
# 全部为可选配置；密钥三通道优先级：
#   工具参数 api_key > 环境变量 ITOL_API_KEY > 密钥文件
# =========================================================

# 通道 2：iTOL API Key（上传/删除必需，导出可选）
# export ITOL_API_KEY="1234567890abcdef..."

# 自定义工作区目录（默认：<cwd>/.itol_mcp_workspace）
# export ITOL_MCP_WORKSPACE="$HOME/itol_workspace"

# 日志级别（DEBUG/INFO/WARNING/ERROR，默认 INFO）
# export ITOL_MCP_LOG_LEVEL="DEBUG"

# 密钥文件路径（默认 ~/.config/itol-mcp/.itolapi.key）
# export ITOL_MCP_KEY_FILE="$HOME/.config/itol-mcp/.itolapi.key"